# (Build-time) Backend the /api rewrite proxies to. Not required — defaults to
# http://localhost:8080 in local development. Override in production.
# API_UPSTREAM=http://localhost:8080

# Optional override for the browser-side API base URL. When unset, the app
# uses the relative path /api (routed through the rewrite above). Set this
# only if you want the browser to talk to a different origin directly.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Public site origin, used for "view your page" and share-link URLs. Defaults
# to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
