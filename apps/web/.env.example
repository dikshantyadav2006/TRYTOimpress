# API base URL the site reads content from (server-side). When the API is
# unreachable, the site falls back to built-in mock content.
API_URL=http://localhost:8000

# Upstream the browser-facing /api/* routes are proxied to (used by the
# client-side quiz answer submission). Defaults to http://localhost:8000 in
# development; set this in production.
# API_UPSTREAM=http://localhost:8000

# Where the platform landing page points new users to register (admin-web).
# Defaults to http://localhost:3002/register in development.
# ADMIN_URL=http://localhost:3002
