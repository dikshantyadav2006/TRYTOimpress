# API server
PORT=8080
HOST=0.0.0.0

# MongoDB connection string. When set, the API connects to Mongo, runs
# migrateOnBoot (backfills ownerId/slugs on existing data, seeds the first
# user's site), and enables the auth/CRUD/upload routes. Each registered user
# owns their own site data (scoped by ownerId).
# Leave unset to run in mock mode (site + proposals only).
MONGODB_URI=mongodb://localhost:27017/proposal

# Cloudinary credentials for /upload (images + video). When unset the
# upload endpoint returns 503 "cloudinary_not_configured".
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
